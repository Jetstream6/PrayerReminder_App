# =============================================================================
# PrayerReminder_App - root .gitignore
# Platform-specific rules live in android/, ios/, macos/, linux/ and windows/.
# =============================================================================

# -----------------------------------------------------------------------------
# Flutter / Dart / Pub
# -----------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.fvm/flutter_sdk
.widget_preview/
migrate_working_dir/
**/doc/api/
**/ios/Flutter/.last_build_id

# pubspec.lock is intentionally tracked: this is an application, not a package,
# so builds should be reproducible.

# -----------------------------------------------------------------------------
# Build output & release artifacts
# -----------------------------------------------------------------------------
/build/
/coverage/
*.apk
*.aab
*.ipa
*.dSYM/
*.dSYM.zip

# Android Studio places build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Symbolication / obfuscation (generated by --split-debug-info and --obfuscate)
app.*.symbols
app.*.map.json

# -----------------------------------------------------------------------------
# Secrets & local configuration - never commit these
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.p12
*.key
secrets.json

# Uncomment if Firebase (or similar) is added and its config should stay private:
#android/app/google-services.json
#ios/Runner/GoogleService-Info.plist

# -----------------------------------------------------------------------------
# IDEs & editors
# -----------------------------------------------------------------------------
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code: ignore personal settings, keep shared project configuration
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Other editors
*.swp
*.swo
*~
.atom/
.history

# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Logs, caches & miscellaneous
# -----------------------------------------------------------------------------
*.log
*.class
*.pyc
.build/
.buildlog/
.swiftpm/
.svn/
